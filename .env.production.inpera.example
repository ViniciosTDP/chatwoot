# Copy to .env on the VPS for docker-compose.production.inpera.yml
# Tuned for ~1 GB RAM test/homolog hosts.

SECRET_KEY_BASE=replace_with_rake_secret_alphanumeric_hex
FRONTEND_URL=https://chat.inpera.com.br
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=true

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change_me_redis_password

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DATABASE=chatwoot

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Low-RAM concurrency (do not raise on 1 GB VPS)
WEB_CONCURRENCY=0
RAILS_MAX_THREADS=2
SIDEKIQ_CONCURRENCY=2

# Evolution API (native Inpera provider)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_PUBLIC_URL=http://192.159.110.58:8080
EVOLUTION_API_KEY=change_me_evolution_api_key
# With FORCE_SSL=true, use public HTTPS (Nginx) so Evolution does not follow HTTP→HTTPS to rails:3000.
# After next image build with webhook SSL exclude, http://rails:3000 also works again.
EVOLUTION_WEBHOOK_BASE_URL=https://chat.inpera.com.br
# Must match password in docker/postgres/init-evolution-db.sql
EVOLUTION_DB_PASSWORD=evolution_change_me

RAILS_LOG_TO_STDOUT=true

# Outbound email (account verification / Devise). Format: Name <email@domain>
# Port 465 = SMTPS → set SMTP_SSL=true and SMTP_ENABLE_STARTTLS_AUTO=false
# Port 587 = STARTTLS → omit SMTP_SSL, set SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_SENDER_EMAIL="INPERA Gestão <noreply@example.com>"
SMTP_ADDRESS=mail.example.com
SMTP_PORT=465
SMTP_DOMAIN=example.com
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_SSL=true
SMTP_OPENSSL_VERIFY_MODE=peer